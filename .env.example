# API server (Hono)
# - Local `pnpm dev` / production single process / Docker container listen
HOST=0.0.0.0
PORT=8787

# Website — Vite local dev only (pnpm dev / pnpm dev:web)
# Production Docker / `pnpm start` serve SPA on PORT (WEB_DEV_PORT unused)
# WEB_HOST default in code is 127.0.0.1 if unset
WEB_HOST=0.0.0.0
WEB_DEV_PORT=5173


# Access control (media proxy + plugin search/chapters/resolve)
# Default ON (1): any client may use media proxy + rule search/chapters/resolve.
# Needed for VPS / public URL; otherwise public browsers get 403 on those APIs.
# Set 0 only for local/LAN-only (stricter: no open egress proxy for the internet).
PUBLIC_PROXY=1
# PUBLIC_PROXY=0          # LAN/loopback only (+ optional PROXY_TOKEN bypass)
# PROXY_TOKEN=secret      # or require X-Animaku-Proxy-Token / ?proxyToken=
# CORS_ORIGINS=https://app.example.com   # extra browser Origins (localhost always ok)
# CORS_ORIGINS=*          # open CORS (not recommended)

# Media proxy scope (orthogonal to PUBLIC_PROXY)
# 0 / unset (default): only proxy m3u8 playlists (+ KEY/MAP); segments stay on CDN.
#     fullProxy=1 and cookie mp4 (Anime1) are rejected. Recommended for public VPS.
# 1: allow full media tunnel (ts/mp4/segments). Needed for Anime1. Higher egress risk.
# MEDIA_FULL_PROXY=0
# Local dev / Docker with Anime1: MEDIA_FULL_PROXY=1

# DanDanPlay credentials (optional)
# Leave empty to use the same built-in client keys as agefans-enhance (local/dev).
# For production, apply open-platform keys at https://www.dandanplay.com/
DANDAN_APP_ID=
DANDAN_APP_SECRET=

# Optional UA overrides (defaults are fine for most local installs)
# Bangumi: non-browser clients should use developer/App/version + open-source homepage
# BANGUMI_USER_AGENT=uerax/Animaku/0.1.0 (https://github.com/uerax/Animaku)
# PRODUCT_USER_AGENT=Animaku/0.1.0
DEFAULT_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36

# Optional rule shop URLs
# PLUGIN_SHOP=https://raw.githubusercontent.com/Predidit/KazumiRules/main/
# PLUGIN_SHOP_MIRROR=https://raw.gitcode.com/gh_mirrors/ka/KazumiRules/raw/main/

# ── Public site URL (SEO) ────────────────────────────────────────────────────
# Absolute origin for sitemap.xml / robots Sitemap line / canonical & OG URLs.
# Runtime (server): SITE_URL — preferred for multi-domain / reverse-proxy deploys.
# Build-time (Vite SPA): VITE_SITE_URL — baked into client for first-paint OG.
# If both empty, server uses request Host; client falls back to window.location.origin.
# SITE_URL=https://anime.example.com
# VITE_SITE_URL=https://anime.example.com

# ── 封面图片源 (Vite build-time) ──────────────────────────────────────────────
# 图片源使用相同的 path，仅切换 host。
# 该值是默认源；用户可在设置页切换，选择保存在浏览器 localStorage。
# Docker 构建时写入 bundle，修改后需 `docker compose up -d --build`。
# 留空时使用内置默认值。
# VITE_BANGUMI_IMAGE_HOST=

# ── Web footer branding (Vite build-time; prefix VITE_ required) ─────────────
# Shown on non-watch pages. Leave blank to hide maintainer / extra links.
# Docker: baked at image build — change then `docker compose up -d --build`.
# GitHub defaults to https://github.com/uerax/Animaku when unset.
# VITE_GITHUB_URL=https://github.com/uerax/Animaku
# VITE_GITHUB_LABEL=GitHub
# VITE_PRODUCT_NAME=Animaku
# VITE_SITE_TAGLINE=在线弹幕播放
# VITE_MAINTAINER_NAME=
# VITE_MAINTAINER_URL=https://github.com/yourname
# VITE_HOMEPAGE_URL=
# VITE_HOMEPAGE_LABEL=主页
# VITE_CONTACT_EMAIL=
# VITE_FOOTER_NOTE=

