<?xml version="1.0" encoding="UTF-8"?>
<!--
  Static fallback for pure static hosting / Vite preview.
  Production Hono serves a Host-aware sitemap at /sitemap.xml (SITE_URL or request Host).
  Replace YOUR_DOMAIN if you only ship the SPA without the server routes.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://YOUR_DOMAIN/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://YOUR_DOMAIN/anime</loc>
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://YOUR_DOMAIN/timeline</loc>
    <changefreq>daily</changefreq>
    <priority>0.8</priority>
  </url>
</urlset>
